{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 - Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "DISDORKTION_BUILD_PLUGIN": "ON",
        "DISDORKTION_BUILD_AUDITION_APP": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-vs2026-dsp-only",
      "displayName": "Windows x64 - Visual Studio 2026 (DSP only)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "DISDORKTION_BUILD_PLUGIN": "OFF",
        "DISDORKTION_BUILD_AUDITION_APP": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "DISDORKTION_BUILD_PLUGIN": "ON",
        "DISDORKTION_BUILD_AUDITION_APP": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-vs2022-dsp-only",
      "displayName": "Windows x64 - Visual Studio 2022 (DSP only)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "DISDORKTION_BUILD_PLUGIN": "OFF",
        "DISDORKTION_BUILD_AUDITION_APP": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-vs2026-debug", "configurePreset": "windows-vs2026", "configuration": "Debug" },
    { "name": "windows-vs2026-release", "configurePreset": "windows-vs2026", "configuration": "Release" },
    { "name": "windows-vs2026-dsp-only-release", "configurePreset": "windows-vs2026-dsp-only", "configuration": "Release" },
    { "name": "windows-vs2022-debug", "configurePreset": "windows-vs2022", "configuration": "Debug" },
    { "name": "windows-vs2022-release", "configurePreset": "windows-vs2022", "configuration": "Release" },
    { "name": "windows-vs2022-dsp-only-release", "configurePreset": "windows-vs2022-dsp-only", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-vs2026-debug", "configurePreset": "windows-vs2026", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-vs2026-release", "configurePreset": "windows-vs2026", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-vs2026-dsp-only-release", "configurePreset": "windows-vs2026-dsp-only", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-vs2022-debug", "configurePreset": "windows-vs2022", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-vs2022-release", "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-vs2022-dsp-only-release", "configurePreset": "windows-vs2022-dsp-only", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
